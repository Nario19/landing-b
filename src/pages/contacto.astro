---
import PublicLayout from "../layouts/PublicLayout.astro";
---

<PublicLayout
  title="Contacto"
  description="Información de contacto para consultas sobre el servicio."
>
  <section class="wrap section-space">
    <h1 class="section-title">Contacto</h1>
    <p class="mt-4 max-w-prose text-muted">
      Huancayo, Junín, Perú. El teléfono, el correo y la dirección de atención
      están pendientes de confirmación.
    </p>
    <h2 class="mt-10 text-2xl font-bold">Datos de atención</h2>
    <p class="mt-2 text-sm font-semibold text-muted">
      Campos de ejemplo para completar con datos oficiales.
    </p>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <article class="panel">
        <h3 class="text-lg font-bold">Teléfono y WhatsApp</h3>
        <p class="mt-2 text-muted">Número de atención por confirmar.</p>
      </article>
      <article class="panel">
        <h3 class="text-lg font-bold">Correo electrónico</h3>
        <p class="mt-2 text-muted">
          Dirección de correo oficial por confirmar.
        </p>
      </article>
      <article class="panel">
        <h3 class="text-lg font-bold">Oficina y horario</h3>
        <p class="mt-2 text-muted">
          Dirección y horario de atención por confirmar.
        </p>
      </article>
    </div>
  </section>
</PublicLayout>
