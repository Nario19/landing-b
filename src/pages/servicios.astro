---
import PublicLayout from "../layouts/PublicLayout.astro";
import { services } from "../data/landing";
---

<PublicLayout
  title="Servicios"
  description="Cómo funciona el transporte urbano en autos colectivos."
>
  <section
    id="servicios"
    class="wrap section-space"
    aria-labelledby="services-title"
  >
    <h1 id="services-title" class="section-title">
      Cómo funciona el servicio
    </h1>
    <ul class="mt-5 divide-y divide-line rounded-3xl bg-surface px-5 sm:px-7">
      {services.map((service) => (
        <li class="py-4">
          <h3 class="font-bold">{service.title}</h3>
          <p class="mt-1 text-muted">{service.text}</p>
        </li>
      ))}
    </ul>
    <h2 class="mt-10 text-2xl font-bold">
      Información que se puede mostrar por servicio
    </h2>
    <p class="mt-2 text-sm font-semibold text-muted">
      Contenido ficticio de demostración.
    </p>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      <article class="panel">
        <h3 class="text-lg font-bold">Traslados al centro</h3>
        <p class="mt-2 text-muted">
          Ejemplo de una ficha con zonas atendidas, puntos de embarque y
          conexiones cercanas.
        </p>
      </article>
      <article class="panel">
        <h3 class="text-lg font-bold">Horarios de mayor demanda</h3>
        <p class="mt-2 text-muted">
          Ejemplo de una ficha con las franjas de salida hacia centros de
          estudio, mercados y oficinas.
        </p>
      </article>
      <article class="panel">
        <h3 class="text-lg font-bold">Atención al pasajero</h3>
        <p class="mt-2 text-muted">
          Ejemplo de una ficha con el canal responsable y el horario de
          atención.
        </p>
      </article>
    </div>
  </section>
</PublicLayout>
