---
import { Image } from "astro:assets";
import personalItems from "../../assets/objetos-personales.jpg";
import travelItems from "../../assets/objetos-de-viaje.jpg";

const examples = [
  {
    image: personalItems,
    alt: "Mochila, paraguas plegable y estuche para lentes",
    caption: "Mochila, paraguas y estuche para lentes",
  },
  {
    image: travelItems,
    alt: "Botella reutilizable junto a una bufanda doblada",
    caption: "Botella reutilizable y bufanda",
  },
];
---

<section
  id="objetos-perdidos"
  class="bg-surface"
  aria-labelledby="lost-items-title"
>
  <div class="wrap section-space">
    <div class="max-w-2xl">
      <h1 id="lost-items-title" class="section-title">
        Objetos perdidos
      </h1>
      <p class="mt-4 text-muted">
        Si olvidaste algo en un colectivo, anota la ruta, la fecha, la hora
        aproximada y una descripción del objeto. Si recuerdas la placa del
        vehículo, anótala también.
      </p>
      <p class="mt-3 text-muted">
        Puedes revisar los{" "}
        <a class="font-semibold underline underline-offset-4" href="/contacto/">
          canales de atención
        </a>
        .
      </p>
    </div>
    <p class="mt-7 text-sm font-semibold text-muted">
      Imágenes ilustrativas de objetos que suelen olvidarse.
    </p>
    <div class="mt-3 grid gap-4 sm:grid-cols-2">
      {examples.map(({ image, alt, caption }) => (
        <figure class="overflow-hidden rounded-3xl border border-line bg-white">
          <Image
            src={image}
            alt={alt}
            widths={[480, 800, 1120]}
            sizes="(max-width: 639px) calc(100vw - 32px), (max-width: 1312px) calc((100vw - 80px) / 2), 616px"
            format="webp"
            class="aspect-[3/2] w-full object-cover"
          />
          <figcaption class="px-5 py-4 text-sm font-semibold">
            {caption}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
